# SplitPee Release Keystore Configuration Example
# Copy this file to `android/key.properties` and fill in your production credentials.
# NOTE: Never commit android/key.properties or your *.jks file to version control!

storePassword=your_keystore_password_here
keyPassword=your_key_password_here
keyAlias=splitpee_upload_key
storeFile=C:/path/to/your/upload-keystore.jks
